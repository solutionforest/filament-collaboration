{
    "name": "solutionforest/filament-collaboration",
    "description": "Google Docs-style collaborative editing for Filament: live fields, presence, cursors and merge on save, over plain HTTP with its own CRDT.",
    "keywords": ["laravel", "filament", "filament-plugin", "collaboration", "crdt", "presence", "real-time", "collaborative editing"],
    "license": "MIT",
    "authors": [
        {
            "name": "Solution Forest",
            "email": "info@solutionforest.net"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.13.3 || ^5.8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\FilamentCollaboration\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolutionForest\\FilamentCollaboration\\FilamentCollaborationServiceProvider"
            ]
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
