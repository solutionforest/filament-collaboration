{
    "name": "solutionforest/filament-collaboration",
    "description": "Collaborative Filament editing: presence, field-level three-way merge on save, and optional shared CRDT drafts — without depending on third-party collaboration plugins.",
    "keywords": ["laravel", "filament", "filament-plugin", "collaboration", "crdt", "presence", "merge"],
    "license": "MIT",
    "authors": [
        {
            "name": "Solution Forest",
            "email": "info@solutionforest.net"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.13.3 || ^5.8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\FilamentCollaboration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\FilamentCollaboration\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolutionForest\\FilamentCollaboration\\FilamentCollaborationServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
