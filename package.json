{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "lint": "eslint .",
        "typecheck": "tsc -p .",
        "test": "node --test \"tests/js/*.test.js\"",
        "test:fixture": "node tests/js/write-fixture.js",
        "check": "npm run lint && npm run typecheck && npm test",
        "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"resources/js/crdt/**\" --test-coverage-lines=95 \"tests/js/*.test.js\""
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "prosemirror-model": "^1.25.13",
        "prosemirror-state": "^1.4.4",
        "prosemirror-transform": "^1.12.7",
        "prosemirror-view": "^1.43.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0"
    }
}
